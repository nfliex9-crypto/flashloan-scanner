# Arbitrum One public RPC. Replace with a reliable provider later if needed.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
RPC_TIMEOUT_SECONDS=15

# Scanner settings
TRADE_SIZE_USDC=1000
POLL_SECONDS=20
MIN_NET_PROFIT_USDC=1

# Small reference quotes used to estimate market price / price impact
REFERENCE_USDC=10
REFERENCE_WETH=0.01

# Uniswap V3 fee tiers to test (ppm: 500 = 0.05%)
UNISWAP_FEE_TIERS=100,500,3000,10000

# Heuristic only: future two-swap + flash-loan transaction gas budget
GAS_UNITS_ESTIMATE=850000
GAS_BUFFER_MULTIPLIER=1.20

# Leave blank to read the current Aave V3 flash-loan premium live on-chain.
# Set a number only when you intentionally want to override it.
BORROW_FEE_BPS=
